<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.aniak.azakron">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/notes"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/notes"
        android:supportsRtl="true"
        android:theme="@style/Theme.Azakron">
        <activity
            android:name=".BaseActivity"
            android:exported="false" />
        <!-- SplashActivity como LAUNCHER -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Azakron">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Azakron" /> <!-- NotesActivity - tela principal após login -->
        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".NoteActivity"
            android:exported="false" />
        <activity
            android:name=".NewNoteActivity"
            android:exported="false" />
    </application>

</manifest>